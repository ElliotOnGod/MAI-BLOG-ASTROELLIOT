<button id="clickme">Dame like a este blog: 0</button>

<script>
    let count = 0;
    const button = document.getElementById("clickme");
    button.addEventListener("click", () => {
        count += 1;
        button.textContent = `Dame like a este blog: ${count}`;
    });
</script>

<style>
    button {
        background: linear-gradient(135deg, #ff71ce, #01cdfe);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-family: "Courier New", monospace;
        font-weight: bold;
        cursor: pointer;
        font-size: 1rem;
    }
    button:hover {
        filter: brightness(1.1);
    }
</style>
